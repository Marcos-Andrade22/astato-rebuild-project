# =====================================================
# Variáveis de ambiente — Produção
# URL da REST API do WordPress
# Ajuste para o endereço onde o WordPress está instalado
# =====================================================

# Se o WordPress estiver na raiz junto com o React:
VITE_WP_API_URL=https://www.astato.com.br/wp-json/wp/v2

# Se o WordPress for movido para um subdiretório /cms/:
# VITE_WP_API_URL=https://www.astato.com.br/cms/wp-json/wp/v2
